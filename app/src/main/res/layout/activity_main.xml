<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Root">

    <LinearLayout
        style="@style/Header"
        android:paddingStart="20dp">

        <TextView
            style="@style/HeaderTitle"
            android:accessibilityHeading="true"
            android:text="Quản lý chi tiêu" />
    </LinearLayout>

    <LinearLayout
        style="@style/Body"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Tổng số tiền đã chi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_total"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng số tiền đã chi"
                android:textColor="@color/on_teal_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/surface"
                android:textSize="32sp" />
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Danh sách khoản chi" />

        <!-- 2. Danh sách khoản chi -->
        <ListView
            android:id="@+id/lvExpenses"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:listSelector="@android:color/transparent" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Chưa có khoản chi nào.\nNhấn Thêm khoản chi để bắt đầu ghi chép."
            android:textColor="@color/text2"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Nhấn vào một khoản chi để xem chi tiết"
            android:textColor="@color/text2"
            android:textSize="12sp" />

        <!-- 3. Nút Thêm khoản chi -->
        <Button
            android:id="@+id/btnAdd"
            style="@style/Btn"
            android:layout_marginTop="12dp"
            android:text="Thêm khoản chi" />
    </LinearLayout>
</LinearLayout>
