<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Root">

    <LinearLayout style="@style/Header">

        <ImageButton
            android:id="@+id/btnUp"
            style="@style/HeaderBack" />

        <TextView
            style="@style/HeaderTitle"
            android:accessibilityHeading="true"
            android:text="Chi tiết khoản chi" />
    </LinearLayout>

    <ScrollView style="@style/Body">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 1. Tên khoản chi -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text"
                    android:textSize="24sp" />

                <!-- 2. Số tiền -->
                <TextView
                    android:id="@+id/tvAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/red"
                    android:textSize="32sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/outline" />

                <!-- 3. Danh mục, ngày chi tiêu, ghi chú -->
                <TextView
                    style="@style/DetailLabel"
                    android:text="Danh mục" />

                <TextView
                    android:id="@+id/tvCategory"
                    style="@style/DetailValue" />

                <TextView
                    style="@style/DetailLabel"
                    android:text="Ngày chi tiêu" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/DetailValue" />

                <TextView
                    style="@style/DetailLabel"
                    android:text="Ghi chú" />

                <TextView
                    android:id="@+id/tvNote"
                    style="@style/DetailValue"
                    android:textIsSelectable="true" />
            </LinearLayout>

            <!-- 4. Nút Quay lại -->
            <Button
                android:id="@+id/btnBack"
                style="@style/Btn"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_btn_outline"
                android:text="Quay lại"
                android:textColor="@color/teal" />

            <!-- 5. Nút Xóa khoản chi -->
            <Button
                android:id="@+id/btnDelete"
                style="@style/Btn"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_red"
                android:text="Xóa khoản chi" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
